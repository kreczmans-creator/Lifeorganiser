<?xml version="1.0" encoding="utf-8"?>
<!-- Only the vault moves in cloud backups and device transfers; secrets in
     shared prefs stay on the handset because they are never included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="vault" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="vault" />
    </device-transfer>
</data-extraction-rules>
